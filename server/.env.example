# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. `docker compose up -d postgres` gives you this locally.
DATABASE_URL="postgresql://omextv:omextv@localhost:5432/omextv?schema=public"

# ── Scaling ──────────────────────────────────────────────────────────────────
# Required to run more than one instance: queue, presence and pairing all live
# here so every node sees the same state. Leave empty for single-process
# in-memory state, which is faster but cannot be scaled horizontally.
# If this is set and Redis is unreachable, the server refuses to boot rather
# than quietly becoming an isolated island in the cluster.
# Deliberately not the default 6379: other tools on a dev machine grab that
# port, and sharing one instance means sharing its memory budget.
REDIS_URL="redis://localhost:6380"
# Identifies this node when routing events between instances. Auto-generated.
INSTANCE_ID=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# The server refuses to boot in production if this is left at the default or is
# shorter than 32 characters.
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"
# Extra origins allowed in production, comma-separated.
ALLOWED_ORIGINS=""

# ── WebRTC ───────────────────────────────────────────────────────────────────
# STUN alone fails for roughly 10-15% of users behind symmetric NAT. A TURN
# relay is required for a reliable production deployment.
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

TURN_SERVER_URL=""
# Extra TURN URLs, e.g. a TLS variant on 443 — that is what gets through
# restrictive corporate firewalls.
TURN_URLS=""

# PREFERRED: coturn REST API shared secret (`use-auth-secret` +
# `static-auth-secret`). Each client is issued short-lived HMAC credentials
# scoped to their user id. A single fixed username/password shipped to every
# browser is a standing invitation to have your relay bandwidth stolen.
TURN_SECRET=""
TURN_TTL_SECONDS=3600
TURN_REALM="omextv"

# Fallback for hosted providers that only offer long-lived credentials.
TURN_SERVER_USERNAME=""
TURN_SERVER_CREDENTIAL=""

# ── Gender inference ─────────────────────────────────────────────────────────
# mock  - deterministic hash-based stub. Tests and local development only;
#         it does NOT look at the picture.
# onnx  - local two-stage inference via onnxruntime-node. Run `npm run
#         models:fetch` first to download the weights (~24 MB).
# http  - POST the frame to a hosted inference endpoint.
GENDER_PROVIDER="onnx"

# Readings below this confidence are discarded and matching falls back to the
# self-declared gender.
#
# Note: verification sends several frames, not one. A single webcam still is a
# noisy sample — the same face can read male on one frame and female on the
# next. The server averages the frames and refuses to answer ("unstable") when
# they disagree, rather than reporting a coin flip as a confident result.
GENDER_CONFIDENCE_THRESHOLD=0.75

# How long a verification stays usable before it is treated as stale.
GENDER_FRESHNESS_HOURS=24

# Where detector.onnx and genderage.onnx live (GENDER_PROVIDER=onnx).
GENDER_MODEL_DIR="./models"

# Which classifier is in that directory.
#   insightface - InsightFace genderage (buffalo_l), 1.3 MB. DEFAULT.
#                 Labels all 19 faces in the bundled group photo correctly,
#                 and returns an age estimate as well.
#   googlenet   - Levi & Hassner GoogLeNet, 23 MB. ~86% accurate; gets two of
#                 those 19 confidently wrong. Kept only for comparison.
# This drives input size, channel order, normalization, crop padding and which
# output index means which gender — a mismatch does not crash, it just makes
# the model quietly worse.
GENDER_CLASSIFIER="insightface"

# Override which output index means which gender. Leave empty to trust the
# classifier's own spec, which is correct for both bundled models. Only set
# this if `npm run gender:check` on photos you know gives inverted answers.
GENDER_CLASS_ORDER=""

# Minimum share of the frame a face must fill to count. Keeps a person in the
# background from tripping the "multiple faces" rejection. On 640x480 the
# default is about a 55x55 px face; a webcam user typically fills 5-25%.
GENDER_MIN_FACE_AREA=0.01

# Detector confidence floor.
GENDER_DETECT_THRESHOLD=0.7

# Hosted inference endpoint (GENDER_PROVIDER=http).
GENDER_API_URL=""
GENDER_API_KEY=""

# Require a fresh verification before a user may enter the queue at all.
REQUIRE_GENDER_VERIFICATION=false

# ── Matchmaking ──────────────────────────────────────────────────────────────
# How often waiting users are re-evaluated so relaxation stages take effect.
MATCH_SWEEP_INTERVAL_MS=2000
# How long a dropped socket may take to reconnect before the chat is ended.
RECONNECT_GRACE_MS=8000
# Reap chats with no traffic for this long. 0 disables.
CHAT_IDLE_TIMEOUT_MS=0
# How many past partners are remembered per user for rematch avoidance.
RECENT_PARTNER_LIMIT=50

# ── Abuse limits ─────────────────────────────────────────────────────────────
QUEUE_JOINS_PER_MIN=30
MESSAGES_PER_MIN=60
SIGNALS_PER_MIN=600
MAX_MESSAGE_LENGTH=1000
# Reports before an automatic temporary suspension. 0 disables.
AUTO_BAN_REPORT_THRESHOLD=5
AUTO_BAN_HOURS=24

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
