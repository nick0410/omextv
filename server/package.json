{
  "name": "omextv-server",
  "version": "1.0.0",
  "description": "Omextv - Random 1v1 Video Chat Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "models:fetch": "node scripts/fetch-models.mjs",
    "gender:check": "tsx scripts/gender-check.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "razorpay:check": "node scripts/razorpay-check.mjs",
    "calls:check": "node scripts/call-charge-check.mjs",
    "coins:check": "node scripts/coin-check.mjs",
    "match:speed": "node scripts/match-speed.mjs",
    "smoke": "node scripts/smoke-match.mjs",
    "probe": "node scripts/probe.mjs && node scripts/probe2.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "onnxruntime-node": "^1.27.0",
    "pngjs": "^7.0.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
