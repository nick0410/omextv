generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered user. `gender` is self-declared; `verifiedGender` is what the
/// vision model inferred from a live camera frame. Matching prefers the
/// verified value when it is fresh and confident, else falls back to declared.
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  username     String @unique

  // --- Gender ---
  gender           String // self-declared: "male" | "female" | "other"
  verifiedGender   String? // model-inferred: "male" | "female" | null
  genderConfidence Float? // 0..1 confidence of the last accepted inference
  genderVerifiedAt DateTime?
  genderAttempts   Int       @default(0) // total inference attempts (abuse signal)
  genderMismatch   Boolean   @default(false) // declared != verified at high confidence

  // --- Location ---
  country String? // ISO 3166-1 alpha-2, uppercase
  city    String?

  // --- Premium ---
  isPremium     Boolean   @default(false)
  premiumExpiry DateTime?

  /// Spendable balance. The ledger is the audit trail; this is the running
  /// total, kept in step with it inside the same transaction so a crash
  /// between the two cannot leave a balance nobody can account for.
  coins Int @default(0)

  // --- Moderation ---
  isBanned    Boolean   @default(false)
  bannedUntil DateTime?
  banReason   String?
  reportCount Int       @default(0)

  isVerified Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reports       Report[]      @relation("reporter")
  reportedBy    Report[]      @relation("reported")
  sessions      Session[]
  payments      Payment[]
  blocksMade    Block[]       @relation("blocker")
  blocksAgainst Block[]       @relation("blocked")
  chatsAsA      ChatSession[] @relation("participantA")
  chatsAsB      ChatSession[] @relation("participantB")
  coinOrders    CoinOrder[]
  coinLedger    CoinLedger[]

  @@index([isBanned])
  @@index([country])
}

/// One completed (or in-flight) 1v1 pairing. Written when the pair is formed
/// so that a crash mid-chat still leaves a record, updated when it ends.
model ChatSession {
  id           String    @id @default(cuid())
  roomId       String    @unique
  userAId      String
  userBId      String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMs   Int?
  /// "skip" | "end" | "disconnect" | "reported" | "timeout" | "server_shutdown"
  endReason    String?
  /// which user ended it, null for server-initiated
  endedById    String?
  matchedOn    String? // JSON: which filters were in play when matched
  messageCount Int       @default(0)

  userA   User     @relation("participantA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User     @relation("participantB", fields: [userBId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userAId])
  @@index([userBId])
  @@index([startedAt])
  @@index([userAId, userBId])
}

/// A persistent one-way block. Blocked pairs are never matched, in either
/// direction.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  sessionId  String?
  reason     String
  category   String   @default("other")
  createdAt  DateTime @default(now())

  reporter User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  session  ChatSession? @relation(fields: [sessionId], references: [id])

  @@unique([reporterId, sessionId])
  @@index([reporterId])
  @@index([reportedId])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  amount            Int
  currency          String   @default("INR")
  plan              String
  status            String   @default("created")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([razorpayOrderId])
}

/// A coin purchase paid by scanning a UPI QR.
///
/// A direct UPI transfer produces no callback: the money simply lands in the
/// payee's account and nothing tells the server about it. So the order records
/// what was promised, holds the reference the payer reads off their own bank
/// app, and waits for a human to match it against the statement. Coins are
/// credited on approval and never before — a "mark as paid" button the payer
/// controls is a button that hands out premium for free.
model CoinOrder {
  id          String    @id @default(cuid())
  userId      String
  packId      String
  /// Fixed when the order is created, so repricing the catalogue later cannot
  /// change what an already-paid order is worth.
  coins       Int
  amountPaise Int
  /// "awaiting_payment" | "under_review" | "approved" | "rejected"
  status      String    @default("awaiting_payment")
  /// The UPI reference (UTR) the payer submits. Unique across every order so
  /// the same transfer cannot be claimed by two accounts, or twice by one.
  upiRef      String?   @unique
  /// Why it was rejected, shown to the payer.
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Every movement of coins, with the balance it produced.
///
/// Money questions are asked after the fact — "why do I have 300?", "did that
/// order get credited twice?" — and a bare balance cannot answer them. Each
/// row records the delta and the balance it resulted in, so the history can be
/// replayed and checked against the total.
model CoinLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  /// "purchase" | "pass" | "refund" | "adjustment"
  reason       String
  /// The CoinOrder or pass id this movement came from.
  refId        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
