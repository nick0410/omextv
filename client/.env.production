# Vite bakes these at BUILD time, so the local .env must never reach a
# production build — a deployed bundle pointing at localhost:3001 sends every
# visitor's browser to their own machine, and HTTPS blocks it as mixed content
# anyway.
#
# Empty means same-origin: requests go to /api and /socket.io on whatever host
# serves the page. Set VITE_API_URL and VITE_SOCKET_URL in the Vercel project
# to the deployed backend once it exists, then redeploy.
VITE_API_URL=
VITE_SOCKET_URL=
